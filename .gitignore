# ============================================================
# ANDROID BUILD FILES
# ============================================================

# Built application files
*.apk
*.ap_
*.aab

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# ============================================================
# GRADLE
# ============================================================

# Gradle files
.gradle/
.gradle-cache/
build/
*/build/
**/build/

# Gradle wrapper JAR must be included for CI/CD!
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Local configuration
local.properties

# Log files
*.log
test_*.log

# ============================================================
# ANDROID STUDIO / INTELLIJ IDEA
# ============================================================

# IntelliJ IDEA
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries/
.idea/libraries/
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/misc.xml
.idea/modules.xml
.idea/navEditor.xml
.idea/deploymentTargetDropDown.xml
.idea/caches/
.idea/modules/
.idea/vcs.xml
.idea/.name
.idea/codeStyles/
.idea/inspectionProfiles/

# Keep useful IntelliJ configurations
!.idea/runConfigurations/
!.idea/codeStyleSettings.xml

# Android Studio Navigation editor
.navigation/

# Android Studio captures folder
captures/
.externalNativeBuild
.cxx/

# ============================================================
# KOTLIN
# ============================================================

*.kotlin_module
.kotlin/

# ============================================================
# SECURITY & SECRETS
# ============================================================

# Keystore files (NEVER commit these!)
*.jks
*.keystore
*.p12

# Signing configuration
signing.properties
keystore.properties

# API keys and secrets
google-services.json
app/google-services.json
serviceAccountKey.json
src/main/resources/serviceAccountKey.json
credentials.json
service-account.json
firebase-adminsdk.json
*-credentials.json
*-secrets.json
*.secrets

# Environment variables
.env
.env.local
.env.*.local

# SSL/TLS certificates
*.crt
*.key
*.pem

# ============================================================
# DATABASE FILES
# ============================================================

# SQLite databases (except if you want sample data in repo)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# ============================================================
# TESTING & COVERAGE
# ============================================================

# Test results
test-results/
**/test-results/

# Coverage reports
coverage/
*.exec
.jacoco/
jacoco/

# Android profiling
*.hprof

# ============================================================
# LOGS
# ============================================================

# Log files
*.log
*.log.*
logs/

# Crash logs
hs_err_pid*
replay_pid*

# ============================================================
# LINT & CODE QUALITY
# ============================================================

lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
*.lint

# ============================================================
# NATIVE CODE (NDK)
# ============================================================

obj/
.externalNativeBuild/

# ============================================================
# PACKAGE FILES
# ============================================================

*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

